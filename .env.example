# Copy this file to `.env.local` and fill in values (never commit `.env.local`).

# Optional: IATI Datastore API key for higher rate limits on poverty grant data.
# Register at https://iatistandard.org/en/developer/
IATI_API_KEY=

# Set to "false" to disable illustrative coverage tiers on the top 10 provinces.
# Defaults to enabled when unset (useful for demos and presentations).
ENABLE_DEMO_COVERAGE=true

# Public site URL (production). Example after deploy: https://track-aid-reconfigured.vercel.app
NEXT_PUBLIC_SITE_URL=
